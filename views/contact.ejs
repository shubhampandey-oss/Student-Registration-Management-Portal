<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main id="mainContent" class="py-5" style="min-height: calc(100vh - 160px);">
  <div class="container d-flex justify-content-center">
    <div class="card p-4 p-md-5 rounded-4 shadow-lg border text-light" style="max-width: 900px; width: 100%; background: var(--cp-card-bg, rgba(17, 24, 39, 0.72)); border-color: var(--cp-border, rgba(255,255,255,0.08)) !important; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);">

      <!-- Header Banner -->
      <div class="border-bottom pb-4 mb-4" style="border-color: rgba(255, 255, 255, 0.1) !important;">
        <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50 px-3 py-2 rounded-pill fw-semibold mb-2">
          <i class="bi bi-chat-dots-fill me-1"></i>Help &amp; Inquiries
        </span>
        <h1 class="display-6 fw-bold text-white mb-2" id="contactHeading">Contact Us</h1>
        <p class="text-muted small mb-0">
          Have questions about the Student Management Portal, admissions, technical issues, or feedback? Get in touch with our support team.
        </p>
      </div>

      <!-- Flash & Error Messages -->
      <%- include('partials/flash') %>

      <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
        <div class="alert alert-danger cp-error-summary mb-4" role="alert" id="errorSummary">
          <h2 class="alert-heading h6 mb-2">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following:
          </h2>
          <ul class="mb-0 ps-3">
            <% errors.forEach(e => { %>
              <li><%= e.msg || e.message %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <!-- Content Grid: Office Details & Inquiry Form -->
      <div class="row g-4 pt-2">

        <!-- Column 1: Office Address & Contact Information -->
        <div class="col-lg-5">
          <div class="h-100 p-4 rounded-3 d-flex flex-column justify-content-between" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
            
            <div>
              <h2 class="h6 text-uppercase fw-bold text-primary mb-3 letter-spacing-1">
                <i class="bi bi-building me-2"></i>Office Information
              </h2>

              <!-- Address Details -->
              <div class="mb-4">
                <p class="text-light fw-semibold mb-1">
                  Cognifyz Technologies Headquarters
                </p>
                <p class="text-muted small mb-0" style="line-height: 1.6;">
                  102 Innovation Tech Park, Outer Ring Road<br />
                  Tech Corridor, Bengaluru, Karnataka 560103<br />
                  India
                </p>
              </div>

              <!-- Support Email Details -->
              <div class="mb-4">
                <h3 class="h6 text-light fw-semibold mb-2 d-flex align-items-center gap-2">
                  <i class="bi bi-envelope-fill text-primary"></i> Support Email
                </h3>
                <p class="mb-1">
                  <a href="mailto:support@cognifyz.com" class="text-info text-decoration-none fw-semibold">
                    support@cognifyz.com
                  </a>
                </p>
                <p class="mb-0">
                  <a href="mailto:contact@cognifyz.com" class="text-muted text-decoration-none small">
                    contact@cognifyz.com
                  </a>
                </p>
              </div>

              <!-- Phone Details -->
              <div class="mb-4">
                <h3 class="h6 text-light fw-semibold mb-2 d-flex align-items-center gap-2">
                  <i class="bi bi-telephone-fill text-primary"></i> Direct Phone
                </h3>
                <p class="text-muted small mb-0">
                  <span class="text-light fw-semibold">+91 (080) 4567-8900</span><br />
                  Toll-Free Helpline: 1800-123-PORTAL
                </p>
              </div>

              <!-- Operating Hours -->
              <div class="mb-3">
                <h3 class="h6 text-light fw-semibold mb-2 d-flex align-items-center gap-2">
                  <i class="bi bi-clock-fill text-primary"></i> Operating Hours
                </h3>
                <p class="text-muted small mb-0">
                  Monday &ndash; Friday: 9:00 AM &ndash; 6:00 PM IST<br />
                  Average Response: &lt; 24 business hours
                </p>
              </div>
            </div>

            <!-- Quick Legal Links -->
            <div class="pt-3 border-top mt-3" style="border-color: rgba(255, 255, 255, 0.08) !important;">
              <span class="text-muted small">Helpful Resources:</span>
              <div class="d-flex gap-2 mt-1">
                <a href="/privacy" class="badge bg-secondary bg-opacity-25 text-light text-decoration-none border border-secondary border-opacity-50">Privacy Policy</a>
                <a href="/terms" class="badge bg-secondary bg-opacity-25 text-light text-decoration-none border border-secondary border-opacity-50">Terms</a>
              </div>
            </div>

          </div>
        </div>

        <!-- Column 2: Feedback & Inquiry Form -->
        <div class="col-lg-7">
          <div class="p-4 rounded-3 h-100" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08);">
            
            <h2 class="h6 text-uppercase fw-bold text-primary mb-3 letter-spacing-1">
              <i class="bi bi-send me-2"></i>Send Feedback or Inquiry
            </h2>

            <form action="/contact" method="POST" id="contactForm" novalidate>
              
              <!-- Full Name Field -->
              <div class="mb-3">
                <label for="contactName" class="form-label cp-label fw-semibold text-light small">
                  Your Full Name <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text bg-dark border-secondary text-muted" style="border-color: rgba(255,255,255,0.12) !important;">
                    <i class="bi bi-person"></i>
                  </span>
                  <input
                    type="text"
                    class="form-control bg-dark text-light <%= (typeof errors !== 'undefined' && errors.find(e => e.field === 'name')) ? 'is-invalid' : '' %>"
                    id="contactName"
                    name="name"
                    placeholder="e.g. John Doe"
                    value="<%= typeof currentUser !== 'undefined' && currentUser ? currentUser.name : (typeof formData !== 'undefined' && formData.name ? formData.name : '') %>"
                    required
                    style="border-color: rgba(255,255,255,0.12) !important;"
                  />
                </div>
              </div>

              <!-- Email Address Field -->
              <div class="mb-3">
                <label for="contactEmail" class="form-label cp-label fw-semibold text-light small">
                  Email Address <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text bg-dark border-secondary text-muted" style="border-color: rgba(255,255,255,0.12) !important;">
                    <i class="bi bi-at"></i>
                  </span>
                  <input
                    type="email"
                    class="form-control bg-dark text-light <%= (typeof errors !== 'undefined' && errors.find(e => e.field === 'email')) ? 'is-invalid' : '' %>"
                    id="contactEmail"
                    name="email"
                    placeholder="name@domain.com"
                    value="<%= typeof currentUser !== 'undefined' && currentUser ? currentUser.email : (typeof formData !== 'undefined' && formData.email ? formData.email : '') %>"
                    required
                    style="border-color: rgba(255,255,255,0.12) !important;"
                  />
                </div>
              </div>

              <!-- Inquiry Subject / Topic -->
              <div class="mb-3">
                <label for="contactSubject" class="form-label cp-label fw-semibold text-light small">
                  Inquiry Topic / Subject <span class="text-danger">*</span>
                </label>
                <select
                  class="form-select bg-dark text-light <%= (typeof errors !== 'undefined' && errors.find(e => e.field === 'subject')) ? 'is-invalid' : '' %>"
                  id="contactSubject"
                  name="subject"
                  required
                  style="border-color: rgba(255,255,255,0.12) !important;"
                >
                  <option value="" disabled <%= !(typeof formData !== 'undefined' && formData.subject) ? 'selected' : '' %>>Select an inquiry category...</option>
                  <option value="General Inquiry" <%= (typeof formData !== 'undefined' && formData.subject === 'General Inquiry') ? 'selected' : '' %>>General Inquiry</option>
                  <option value="Portal & Account Support" <%= (typeof formData !== 'undefined' && formData.subject === 'Portal & Account Support') ? 'selected' : '' %>>Portal &amp; Account Support</option>
                  <option value="Student Admission & Enrollment" <%= (typeof formData !== 'undefined' && formData.subject === 'Student Admission & Enrollment') ? 'selected' : '' %>>Student Admission &amp; Enrollment</option>
                  <option value="Technical Issue / Bug Report" <%= (typeof formData !== 'undefined' && formData.subject === 'Technical Issue / Bug Report') ? 'selected' : '' %>>Technical Issue / Bug Report</option>
                  <option value="Feedback & Suggestions" <%= (typeof formData !== 'undefined' && formData.subject === 'Feedback & Suggestions') ? 'selected' : '' %>>Feedback &amp; Suggestions</option>
                </select>
              </div>

              <!-- Message Field -->
              <div class="mb-4">
                <label for="contactMessage" class="form-label cp-label fw-semibold text-light small">
                  Message / Feedback <span class="text-danger">*</span>
                </label>
                <textarea
                  class="form-control bg-dark text-light <%= (typeof errors !== 'undefined' && errors.find(e => e.field === 'message')) ? 'is-invalid' : '' %>"
                  id="contactMessage"
                  name="message"
                  rows="4"
                  placeholder="Please enter your questions, feedback, or inquiry in detail..."
                  required
                  style="border-color: rgba(255,255,255,0.12) !important;"
                ><%= typeof formData !== 'undefined' && formData.message ? formData.message : '' %></textarea>
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                class="btn cp-btn-primary w-100 py-2 fw-semibold shadow-sm"
                id="submitContactBtn"
              >
                <i class="bi bi-send-fill me-2"></i>Send Message
              </button>

            </form>

          </div>
        </div>

      </div>

    </div>
  </div>
</main>

<%- include('partials/footer') %>
