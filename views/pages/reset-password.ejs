<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main id="mainContent" class="cp-page-main">
  <div class="container py-5">

    <!-- Page Header -->
    <div class="row justify-content-center mb-4">
      <div class="col-lg-6 text-center">
        <span class="cp-badge mb-2">
          <% if (typeof userRole !== 'undefined' && userRole === 'admin') { %>
            <i class="bi bi-shield-check me-1 text-danger"></i>Administrator Password Reset
          <% } else { %>
            <i class="bi bi-key me-1 text-primary"></i>Student Password Reset
          <% } %>
        </span>
        <h1 class="cp-page-title">Reset Your Password</h1>
        <p class="text-muted">
          Choose a secure new password meeting all portal security criteria.
        </p>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-6 col-md-8">

        <%- include('../partials/flash') %>

        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger cp-error-summary mb-4" role="alert" id="errorSummary">
            <h2 class="alert-heading h6 mb-2">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>Please fix the following:
            </h2>
            <ul class="mb-0 ps-3">
              <% errors.forEach(e => { %>
                <li><%= e.msg || e.message %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>

        <!-- Reset Password Card -->
        <div class="cp-form-card shadow-sm p-4 rounded-4 bg-white border" id="resetCard">
          <form action="/auth/reset-password" method="POST" id="resetPasswordForm" novalidate>
            <input type="hidden" name="email" id="resetEmail" value="<%= typeof email !== 'undefined' ? email : (old && old.email ? old.email : '') %>" />

            <!-- Account Summary Badge -->
            <div class="p-3 mb-4 rounded-3 border bg-light d-flex align-items-center justify-content-between">
              <div>
                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Resetting Password For</small>
                <span class="fw-semibold text-dark fs-6" id="displayEmail">
                  <%= typeof email !== 'undefined' ? email : (old && old.email ? old.email : '') %>
                </span>
              </div>
              <span class="badge <%= (typeof userRole !== 'undefined' && userRole === 'admin') ? 'bg-danger' : 'bg-primary' %> px-3 py-2 rounded-pill text-uppercase" style="font-size: 0.75rem;">
                <i class="bi <%= (typeof userRole !== 'undefined' && userRole === 'admin') ? 'bi-shield-lock' : 'bi-person-badge' %> me-1"></i>
                <%= (typeof userRole !== 'undefined' && userRole === 'admin') ? 'Administrator' : 'Student' %>
              </span>
            </div>

            <!-- Admin Secret Key (Required ONLY for Admin accounts) -->
            <% if (typeof userRole !== 'undefined' && userRole === 'admin') { %>
              <div class="mb-3" id="adminSecretGroup">
                <label for="adminSecretKey" class="form-label cp-label fw-semibold">
                  <i class="bi bi-key-fill me-1 text-danger"></i>Admin Secret Key <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <input
                    type="password"
                    class="form-control form-control-lg <%= errors.find(e => e.field === 'adminSecretKey') ? 'is-invalid' : '' %>"
                    id="adminSecretKey"
                    name="adminSecretKey"
                    placeholder="Enter organization admin secret key"
                    value="<%= old && old.adminSecretKey ? old.adminSecretKey : '' %>"
                    required
                    autocomplete="off"
                  />
                  <button
                    class="btn btn-outline-secondary"
                    type="button"
                    id="toggleSecretKeyBtn"
                    title="Toggle secret key visibility"
                  >
                    <i class="bi bi-eye" id="toggleSecretKeyIcon"></i>
                  </button>
                </div>
                <div class="invalid-feedback <%= errors.find(e => e.field === 'adminSecretKey') ? 'd-block' : '' %>" id="secretKeyFeedback">
                  <%= errors.find(e => e.field === 'adminSecretKey')?.msg || 'Valid Admin Secret Key is required.' %>
                </div>
                <small class="form-text text-muted">Administrator secret authorization passkey is required to reset an administrator account.</small>
              </div>
            <% } %>

            <!-- New Password Field -->
            <div class="mb-3">
              <label for="newPassword" class="form-label cp-label fw-semibold">
                <i class="bi bi-lock me-1 text-primary"></i>New Password <span class="text-danger">*</span>
              </label>
              <div class="input-group">
                <input
                  type="password"
                  class="form-control form-control-lg <%= errors.find(e => e.field === 'newPassword') ? 'is-invalid' : '' %>"
                  id="newPassword"
                  name="newPassword"
                  value="<%= old && old.newPassword ? old.newPassword : '' %>"
                  placeholder="Min 8 characters (mixed case, numbers, symbols)"
                  required
                  autocomplete="new-password"
                />
                <button
                  class="btn btn-outline-secondary"
                  type="button"
                  id="toggleNewPasswordBtn"
                  title="Toggle password visibility"
                >
                  <i class="bi bi-eye" id="toggleNewPasswordIcon"></i>
                </button>
              </div>
              <div class="invalid-feedback <%= errors.find(e => e.field === 'newPassword') ? 'd-block' : '' %>" id="newPasswordFeedback">
                <%= errors.find(e => e.field === 'newPassword')?.msg || errors.find(e => e.field === 'newPassword')?.message || 'Password must be at least 8 characters and include uppercase, lowercase, numbers, and special characters.' %>
              </div>

              <!-- Password Strength Meter -->
              <div class="progress mt-2" style="height: 6px;">
                <div
                  id="newStrengthBar"
                  class="progress-bar bg-danger"
                  role="progressbar"
                  style="width: 0%; transition: width 0.3s ease;"
                  aria-valuenow="0"
                  aria-valuemin="0"
                  aria-valuemax="100"
                ></div>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-1">
                <small id="newStrengthLabel" class="text-muted fw-bold">Enter a password</small>
                <small class="text-muted">Min 8 chars, mixed case, numbers & symbols</small>
              </div>

              <!-- Requirements checklist -->
              <div class="p-2 mt-2 bg-light rounded border border-light-subtle small">
                <div class="row g-1">
                  <div class="col-6" id="ruleLen"><i class="bi bi-circle text-muted me-1"></i>8+ characters</div>
                  <div class="col-6" id="ruleUpper"><i class="bi bi-circle text-muted me-1"></i>Uppercase (A-Z)</div>
                  <div class="col-6" id="ruleLower"><i class="bi bi-circle text-muted me-1"></i>Lowercase (a-z)</div>
                  <div class="col-6" id="ruleDigit"><i class="bi bi-circle text-muted me-1"></i>Number (0-9)</div>
                  <div class="col-12" id="ruleSpec"><i class="bi bi-circle text-muted me-1"></i>Special character (!@#$%^&*...)</div>
                </div>
              </div>
            </div>

            <!-- Confirm New Password Field -->
            <div class="mb-4">
              <label for="confirmPassword" class="form-label cp-label fw-semibold">
                <i class="bi bi-lock-fill me-1 text-primary"></i>Confirm New Password <span class="text-danger">*</span>
              </label>
              <input
                type="password"
                class="form-control form-control-lg <%= errors.find(e => e.field === 'confirmPassword') ? 'is-invalid' : '' %>"
                id="confirmPassword"
                name="confirmPassword"
                value="<%= old && old.confirmPassword ? old.confirmPassword : '' %>"
                placeholder="Re-enter your new password"
                required
                autocomplete="new-password"
              />
              <div class="invalid-feedback <%= errors.find(e => e.field === 'confirmPassword') ? 'd-block' : '' %>" id="confirmFeedback">
                <%= errors.find(e => e.field === 'confirmPassword')?.msg || errors.find(e => e.field === 'confirmPassword')?.message || 'Passwords must match exactly.' %>
              </div>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="btn <%= (typeof userRole !== 'undefined' && userRole === 'admin') ? 'btn-danger' : 'btn-primary' %> btn-lg w-100 fw-semibold mb-3 shadow-sm"
              id="submitResetBtn"
            >
              <i class="bi bi-check2-circle me-2"></i>Reset Password
            </button>
          </form>

          <!-- Back to login link -->
          <div class="text-center mt-3 border-top pt-3">
            <a href="/auth/login" class="text-muted text-decoration-none">
              <i class="bi bi-arrow-left me-1"></i>Cancel and Return to Sign In
            </a>
          </div>
        </div>

      </div>
    </div>

  </div>
</main>

<script>
  // Toggle password visibility
  document.getElementById('toggleNewPasswordBtn')?.addEventListener('click', function() {
    const input = document.getElementById('newPassword');
    const icon = document.getElementById('toggleNewPasswordIcon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.replace('bi-eye', 'bi-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.replace('bi-eye-slash', 'bi-eye');
    }
  });

  // Toggle secret key visibility (admin only)
  document.getElementById('toggleSecretKeyBtn')?.addEventListener('click', function() {
    const input = document.getElementById('adminSecretKey');
    const icon = document.getElementById('toggleSecretKeyIcon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.replace('bi-eye', 'bi-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.replace('bi-eye-slash', 'bi-eye');
    }
  });

  const pwInput = document.getElementById('newPassword');
  const confirmInput = document.getElementById('confirmPassword');
  const pwFeedback = document.getElementById('newPasswordFeedback');
  const confirmFeedback = document.getElementById('confirmFeedback');
  const bar = document.getElementById('newStrengthBar');
  const label = document.getElementById('newStrengthLabel');
  const form = document.getElementById('resetPasswordForm');
  const adminSecretInput = document.getElementById('adminSecretKey');

  function updateRule(elemId, passed) {
    const el = document.getElementById(elemId);
    if (!el) return;
    if (passed) {
      el.className = 'text-success fw-semibold';
      el.innerHTML = '<i class="bi bi-check-circle-fill text-success me-1"></i>' + el.textContent.replace(/^.*?([A-Za-z0-9])/, '$1');
    } else {
      el.className = 'text-muted';
      el.innerHTML = '<i class="bi bi-circle text-muted me-1"></i>' + el.textContent.replace(/^.*?([A-Za-z0-9])/, '$1');
    }
  }

  function validatePasswordRules(val) {
    const trimmed = (val || '').trim();
    const checks = {
      minLength: trimmed.length >= 8,
      hasUpper: /[A-Z]/.test(trimmed),
      hasLower: /[a-z]/.test(trimmed),
      hasDigit: /[0-9]/.test(trimmed),
      hasSpecial: /[^A-Za-z0-9]/.test(trimmed) || /[!@#$%^&*()_+\-=[\]{};':"\\|,.<>/?`~]/.test(trimmed),
    };
    const isValid = checks.minLength && checks.hasUpper && checks.hasLower && checks.hasDigit && checks.hasSpecial;
    return { checks, isValid, trimmed };
  }

  function evaluateLivePassword() {
    if (!pwInput) return;
    const val = pwInput.value;
    const { checks, isValid } = validatePasswordRules(val);

    updateRule('ruleLen', checks.minLength);
    updateRule('ruleUpper', checks.hasUpper);
    updateRule('ruleLower', checks.hasLower);
    updateRule('ruleDigit', checks.hasDigit);
    updateRule('ruleSpec', checks.hasSpecial);

    if (!bar || !label) return;

    if (val.length === 0) {
      bar.style.width = '0%';
      bar.className = 'progress-bar bg-danger';
      label.textContent = 'Enter a password';
      label.className = 'text-muted fw-bold';
      return;
    }

    let score = 0;
    if (checks.minLength) score++;
    if (checks.hasUpper) score++;
    if (checks.hasLower) score++;
    if (checks.hasDigit) score++;
    if (checks.hasSpecial) score++;
    if (val.length >= 12 && score >= 4) score = 5;

    const percent = Math.min(score * 20, 100);
    bar.style.width = percent + '%';

    if (score <= 1) {
      bar.className = 'progress-bar bg-danger';
      label.textContent = 'Very Weak';
      label.className = 'text-danger fw-bold';
    } else if (score === 2) {
      bar.className = 'progress-bar bg-warning';
      label.textContent = 'Weak';
      label.className = 'text-warning fw-bold';
    } else if (score === 3) {
      bar.className = 'progress-bar bg-info';
      label.textContent = 'Medium';
      label.className = 'text-info fw-bold';
    } else if (score === 4) {
      bar.className = 'progress-bar bg-primary';
      label.textContent = 'Strong';
      label.className = 'text-primary fw-bold';
    } else {
      bar.className = 'progress-bar bg-success';
      label.textContent = 'Very Strong';
      label.className = 'text-success fw-bold';
    }
  }

  pwInput?.addEventListener('input', function() {
    evaluateLivePassword();
    pwInput.classList.remove('is-invalid');
    if (pwFeedback) pwFeedback.classList.remove('d-block');
  });

  confirmInput?.addEventListener('input', function() {
    confirmInput.classList.remove('is-invalid');
    if (confirmFeedback) confirmFeedback.classList.remove('d-block');
  });

  adminSecretInput?.addEventListener('input', function() {
    adminSecretInput.classList.remove('is-invalid');
    const secretKeyFeedback = document.getElementById('secretKeyFeedback');
    if (secretKeyFeedback) secretKeyFeedback.classList.remove('d-block');
  });

  form?.addEventListener('submit', function(e) {
    let hasError = false;

    if (adminSecretInput && !adminSecretInput.value.trim()) {
      e.preventDefault();
      hasError = true;
      adminSecretInput.classList.add('is-invalid');
      const secretKeyFeedback = document.getElementById('secretKeyFeedback');
      if (secretKeyFeedback) {
        secretKeyFeedback.textContent = 'Admin Secret Key is required for administrator accounts.';
        secretKeyFeedback.classList.add('d-block');
      }
    }

    const { isValid } = validatePasswordRules(pwInput?.value || '');
    if (!isValid) {
      e.preventDefault();
      hasError = true;
      pwInput?.classList.add('is-invalid');
      if (pwFeedback) {
        pwFeedback.textContent = 'Password must be at least 8 characters and include uppercase, lowercase, numbers, and special characters.';
        pwFeedback.classList.add('d-block');
      }
    }

    const pw = (pwInput?.value || '').trim();
    const cpw = (confirmInput?.value || '').trim();
    if (cpw.length === 0 || pw !== cpw) {
      e.preventDefault();
      hasError = true;
      confirmInput?.classList.add('is-invalid');
      if (confirmFeedback) {
        confirmFeedback.textContent = 'Passwords do not match.';
        confirmFeedback.classList.add('d-block');
      }
    }

    if (hasError) {
      const firstInvalid = form.querySelector('.is-invalid');
      firstInvalid?.focus();
    }
  });
</script>

<%- include('../partials/footer') %>
