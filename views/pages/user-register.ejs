<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main id="mainContent" class="cp-page-main">
  <div class="container py-5">

    <div class="row justify-content-center mb-4">
      <div class="col-lg-6 text-center">
        <span class="cp-badge mb-2">
          <i class="bi bi-person-plus me-1"></i>New Account
        </span>
        <h1 class="cp-page-title">Create Account</h1>
        <p class="text-muted">
          Register an account to securely access the student portal and view academic records.
        </p>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-6 col-md-8">

        <%- include('../partials/flash') %>

        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger cp-error-summary mb-4" role="alert" id="errorSummary">
            <h2 class="alert-heading h6 mb-2">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>Please fix the following:
            </h2>
            <ul class="mb-0 ps-3">
              <% errors.forEach(e => { %>
                <li><%= e.msg || e.message %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>

        <div class="cp-form-card shadow-sm p-4 rounded-4 bg-white border">
          <form action="/auth/register" method="POST" id="userRegisterForm" novalidate>

            <!-- Full Name -->
            <div class="mb-3">
              <label for="userName" class="form-label cp-label fw-semibold">
                <i class="bi bi-person me-1 text-primary"></i>Full Name <span class="text-danger">*</span>
              </label>
              <input
                type="text"
                class="form-control form-control-lg <%= errors.find(e => e.field === 'name') ? 'is-invalid' : '' %>"
                id="userName"
                name="name"
                placeholder="e.g. Aditi Sharma"
                value="<%= old && old.name ? old.name : '' %>"
                required
                autocomplete="name"
              />
              <div class="invalid-feedback">Full name is required (at least 2 characters).</div>
            </div>

            <!-- Email -->
            <div class="mb-3">
              <label for="userEmail" class="form-label cp-label fw-semibold">
                <i class="bi bi-envelope me-1 text-primary"></i>Email Address <span class="text-danger">*</span>
              </label>
              <input
                type="email"
                class="form-control form-control-lg <%= errors.find(e => e.field === 'email') ? 'is-invalid' : '' %>"
                id="userEmail"
                name="email"
                placeholder="aditi@example.com"
                value="<%= old && old.email ? old.email : '' %>"
                required
                autocomplete="email"
              />
              <div class="invalid-feedback">Please enter a valid, unique email address.</div>
            </div>

            <!-- Role Selection -->
            <div class="mb-3">
              <label for="userRole" class="form-label cp-label fw-semibold">
                <i class="bi bi-shield-check me-1 text-primary"></i>Account Role
              </label>
              <select class="form-select form-select-lg" id="userRole" name="role">
                <option value="student" <%= (old && old.role === 'student') ? 'selected' : '' %>>Student User (Standard Access)</option>
                <option value="admin" <%= (old && old.role === 'admin') ? 'selected' : '' %>>Administrator (Full CRUD & Delete Access)</option>
              </select>
              <div class="form-text">Administrators can perform protected actions like student record deletion.</div>
            </div>

            <!-- Password -->
            <div class="mb-3">
              <label for="userPassword" class="form-label cp-label fw-semibold">
                <i class="bi bi-lock me-1 text-primary"></i>Password <span class="text-danger">*</span>
              </label>
              <div class="input-group">
                <input
                  type="password"
                  class="form-control form-control-lg <%= errors.find(e => e.field === 'password') ? 'is-invalid' : '' %>"
                  id="userPassword"
                  name="password"
                  placeholder="Min 8 characters (mixed case, numbers, symbols)"
                  required
                  autocomplete="new-password"
                />
                <button
                  class="btn btn-outline-secondary"
                  type="button"
                  id="toggleUserPasswordBtn"
                  title="Toggle password visibility"
                >
                  <i class="bi bi-eye" id="toggleUserPasswordIcon"></i>
                </button>
              </div>
              <div class="invalid-feedback <%= errors.find(e => e.field === 'password') ? 'd-block' : '' %>" id="userPasswordFeedback">
                <%= errors.find(e => e.field === 'password')?.msg || errors.find(e => e.field === 'password')?.message || 'Password must be at least 8 characters and include uppercase, lowercase, numbers, and special characters.' %>
              </div>

              <!-- Password Strength Meter -->
              <div class="progress mt-2" style="height: 6px;">
                <div
                  id="userStrengthBar"
                  class="progress-bar bg-danger"
                  role="progressbar"
                  style="width: 0%; transition: width 0.3s ease;"
                  aria-valuenow="0"
                  aria-valuemin="0"
                  aria-valuemax="100"
                ></div>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-1">
                <small id="userStrengthLabel" class="text-muted fw-bold">Enter a password</small>
                <small class="text-muted">Min 8 chars, mixed case, numbers & symbols</small>
              </div>

              <!-- Password Requirements Checklist -->
              <div class="p-2 mt-2 bg-light rounded border border-light-subtle small">
                <div class="row g-1">
                  <div class="col-6" id="ruleLen"><i class="bi bi-circle text-muted me-1"></i>8+ characters</div>
                  <div class="col-6" id="ruleUpper"><i class="bi bi-circle text-muted me-1"></i>Uppercase (A-Z)</div>
                  <div class="col-6" id="ruleLower"><i class="bi bi-circle text-muted me-1"></i>Lowercase (a-z)</div>
                  <div class="col-6" id="ruleDigit"><i class="bi bi-circle text-muted me-1"></i>Number (0-9)</div>
                  <div class="col-12" id="ruleSpec"><i class="bi bi-circle text-muted me-1"></i>Special character (!@#$%^&*...)</div>
                </div>
              </div>
            </div>

            <!-- Confirm Password -->
            <div class="mb-4">
              <label for="userConfirmPassword" class="form-label cp-label fw-semibold">
                <i class="bi bi-lock-fill me-1 text-primary"></i>Confirm Password <span class="text-danger">*</span>
              </label>
              <input
                type="password"
                class="form-control form-control-lg <%= errors.find(e => e.field === 'confirmPassword') ? 'is-invalid' : '' %>"
                id="userConfirmPassword"
                name="confirmPassword"
                placeholder="Re-enter your password"
                required
                autocomplete="new-password"
              />
              <div class="invalid-feedback <%= errors.find(e => e.field === 'confirmPassword') ? 'd-block' : '' %>" id="userConfirmFeedback">
                <%= errors.find(e => e.field === 'confirmPassword')?.msg || errors.find(e => e.field === 'confirmPassword')?.message || 'Passwords must match exactly.' %>
              </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold mb-3 shadow-sm" id="submitUserRegisterBtn">
              <i class="bi bi-check-circle me-2"></i>Create Account
            </button>
          </form>

          <div class="text-center mt-3">
            <span class="text-muted">Already have an account?</span>
            <a href="/auth/login?portal=student" class="fw-semibold text-primary ms-1">Student Sign In</a>
            <span class="text-muted mx-1">·</span>
            <a href="/auth/login?portal=admin" class="fw-semibold text-danger">Admin Sign In</a>
          </div>
        </div>

      </div>
    </div>

  </div>
</main>

<script>
  // Toggle password visibility
  document.getElementById('toggleUserPasswordBtn')?.addEventListener('click', function() {
    const input = document.getElementById('userPassword');
    const icon = document.getElementById('toggleUserPasswordIcon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.replace('bi-eye', 'bi-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.replace('bi-eye-slash', 'bi-eye');
    }
  });

  const pwInput = document.getElementById('userPassword');
  const confirmInput = document.getElementById('userConfirmPassword');
  const pwFeedback = document.getElementById('userPasswordFeedback');
  const confirmFeedback = document.getElementById('userConfirmFeedback');
  const bar = document.getElementById('userStrengthBar');
  const label = document.getElementById('userStrengthLabel');
  const form = document.getElementById('userRegisterForm');

  function updateRule(elemId, passed) {
    const el = document.getElementById(elemId);
    if (!el) return;
    if (passed) {
      el.className = 'text-success fw-semibold';
      el.innerHTML = '<i class="bi bi-check-circle-fill text-success me-1"></i>' + el.textContent.replace(/^.*?([A-Za-z0-9])/, '$1');
    } else {
      el.className = 'text-muted';
      el.innerHTML = '<i class="bi bi-circle text-muted me-1"></i>' + el.textContent.replace(/^.*?([A-Za-z0-9])/, '$1');
    }
  }

  function validatePasswordRules(val) {
    const trimmed = (val || '').trim();
    const checks = {
      minLength: trimmed.length >= 8,
      hasUpper: /[A-Z]/.test(trimmed),
      hasLower: /[a-z]/.test(trimmed),
      hasDigit: /[0-9]/.test(trimmed),
      hasSpecial: /[^A-Za-z0-9]/.test(trimmed) || /[!@#$%^&*()_+\-=[\]{};':"\\|,.<>/?`~]/.test(trimmed),
    };
    const isValid = checks.minLength && checks.hasUpper && checks.hasLower && checks.hasDigit && checks.hasSpecial;
    return { checks, isValid, trimmed };
  }

  function evaluateLivePassword() {
    if (!pwInput) return;
    const val = pwInput.value;
    const { checks, isValid } = validatePasswordRules(val);

    updateRule('ruleLen', checks.minLength);
    updateRule('ruleUpper', checks.hasUpper);
    updateRule('ruleLower', checks.hasLower);
    updateRule('ruleDigit', checks.hasDigit);
    updateRule('ruleSpec', checks.hasSpecial);

    if (!bar || !label) return;

    if (val.length === 0) {
      bar.style.width = '0%';
      bar.className = 'progress-bar bg-danger';
      label.textContent = 'Enter a password';
      label.className = 'text-muted fw-bold';
      return;
    }

    let score = 0;
    if (checks.minLength) score++;
    if (checks.hasUpper) score++;
    if (checks.hasLower) score++;
    if (checks.hasDigit) score++;
    if (checks.hasSpecial) score++;
    if (val.length >= 12 && score >= 4) score = 5;

    const percent = Math.min(score * 20, 100);
    bar.style.width = percent + '%';

    if (score <= 1) {
      bar.className = 'progress-bar bg-danger';
      label.textContent = 'Very Weak';
      label.className = 'text-danger fw-bold';
    } else if (score === 2) {
      bar.className = 'progress-bar bg-warning';
      label.textContent = 'Weak';
      label.className = 'text-warning fw-bold';
    } else if (score === 3) {
      bar.className = 'progress-bar bg-info';
      label.textContent = 'Medium';
      label.className = 'text-info fw-bold';
    } else if (score === 4) {
      bar.className = 'progress-bar bg-primary';
      label.textContent = 'Strong';
      label.className = 'text-primary fw-bold';
    } else {
      bar.className = 'progress-bar bg-success';
      label.textContent = 'Very Strong';
      label.className = 'text-success fw-bold';
    }
  }

  pwInput?.addEventListener('input', function() {
    evaluateLivePassword();
    pwInput.classList.remove('is-invalid');
    if (pwFeedback) pwFeedback.classList.remove('d-block');
  });

  confirmInput?.addEventListener('input', function() {
    confirmInput.classList.remove('is-invalid');
    if (confirmFeedback) confirmFeedback.classList.remove('d-block');
  });

  // Client-side submission validation
  form?.addEventListener('submit', function(e) {
    let hasError = false;
    const { isValid } = validatePasswordRules(pwInput?.value || '');

    if (!isValid) {
      e.preventDefault();
      hasError = true;
      pwInput?.classList.add('is-invalid');
      if (pwFeedback) {
        pwFeedback.textContent = 'Password must be at least 8 characters and include uppercase, lowercase, numbers, and special characters.';
        pwFeedback.classList.add('d-block');
      }
    }

    const pw = (pwInput?.value || '').trim();
    const cpw = (confirmInput?.value || '').trim();
    if (cpw.length === 0 || pw !== cpw) {
      e.preventDefault();
      hasError = true;
      confirmInput?.classList.add('is-invalid');
      if (confirmFeedback) {
        confirmFeedback.textContent = 'Passwords do not match.';
        confirmFeedback.classList.add('d-block');
      }
    }

    if (hasError) {
      const firstInvalid = form.querySelector('.is-invalid');
      firstInvalid?.focus();
    }
  });
</script>

<%- include('../partials/footer') %>
