<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main id="mainContent" class="cp-page-main">
  <div class="container py-5">

    <div class="row justify-content-center mb-4">
      <div class="col-lg-8">
        <%- include('../partials/flash') %>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
          <div>
            <span class="cp-badge mb-2">
              <i class="bi bi-shield-check me-1"></i>Authenticated Session
            </span>
            <h1 class="cp-page-title mb-1">User Dashboard</h1>
            <p class="text-muted mb-0">Welcome to your personal account management workspace.</p>
          </div>
          <div class="d-flex gap-2">
            <a href="/students" class="btn btn-outline-primary">
              <i class="bi bi-people me-1"></i>View Students
            </a>
            <a href="/auth/logout" class="btn btn-outline-danger">
              <i class="bi bi-box-arrow-right me-1"></i>Sign Out
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
          <div class="d-flex align-items-center gap-3 mb-4">
            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
              <i class="bi bi-person-fill fs-2"></i>
            </div>
            <div>
              <h3 class="h5 mb-0 fw-bold"><%= user.name %></h3>
              <span class="text-muted"><%= user.email %></span>
              <span class="badge <%= user.role === 'admin' ? 'bg-danger' : 'bg-success' %> ms-2 text-uppercase">
                <%= user.role %>
              </span>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <div class="p-3 bg-light rounded-3">
                <span class="text-muted small d-block">Account User ID</span>
                <strong class="fs-5">#<%= user.id %></strong>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-3 bg-light rounded-3">
                <span class="text-muted small d-block">Database Engine</span>
                <strong class="fs-5"><i class="bi bi-database me-1 text-info"></i>SQLite (sql.js)</strong>
              </div>
            </div>
          </div>

          <% if (user.role === 'admin') { %>
            <div class="alert alert-info mt-4 mb-0">
              <i class="bi bi-info-circle me-1"></i>
              You have administrator privileges. You can view the <a href="/auth/admin" class="alert-link">Admin Console</a>.
            </div>
          <% } %>
        </div>

        <!-- ── Account Actions Section (Danger Zone) ──────────────── -->
        <div class="card shadow-sm border-danger border-opacity-25 rounded-4 p-4 mb-4 bg-white" id="accountActionsCard">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
              <h3 class="h6 text-danger fw-bold mb-1">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Account Actions &amp; Danger Zone
              </h3>
              <p class="text-muted small mb-0">
                Permanently delete your user account and all associated registration records.
              </p>
            </div>
            <form action="/account/delete" method="POST" id="deleteAccountForm" onsubmit="return confirm('Are you sure you want to permanently delete your account?');" class="d-inline">
              <button
                type="submit"
                class="btn btn-outline-danger fw-semibold"
                id="deleteAccountBtn"
              >
                <i class="bi bi-trash3-fill me-1"></i>Delete My Account
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>

  </div>
</main>

<!-- ── Delete Account Confirmation Modal ────────────────────────────── -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title text-danger fw-bold d-flex align-items-center gap-2" id="deleteAccountModalLabel">
          <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>Confirm Account Deletion
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/account/delete" method="POST" id="deleteAccountForm">
        <div class="modal-body py-3">
          <div class="alert alert-danger border-0 bg-danger bg-opacity-10 py-2 small mb-3">
            <i class="bi bi-shield-exclamation me-1"></i><strong>Warning:</strong> This action is permanent and cannot be undone.
          </div>
          <p class="text-muted mb-3">
            Are you sure you want to delete your account? This action cannot be undone.
          </p>
          <div class="mb-3">
            <label for="deleteConfirmPassword" class="form-label small fw-semibold text-secondary">
              Current Password <span class="text-muted fw-normal">(optional verification)</span>:
            </label>
            <input
              type="password"
              class="form-control"
              id="deleteConfirmPassword"
              name="password"
              placeholder="Enter current password"
              autocomplete="current-password"
            />
          </div>
        </div>
        <div class="modal-footer border-top-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger fw-semibold px-4" id="confirmDeleteAccountBtn">
            <i class="bi bi-trash3-fill me-1"></i>Yes, Delete My Account
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
