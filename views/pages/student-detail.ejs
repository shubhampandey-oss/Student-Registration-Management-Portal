<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main id="mainContent" class="cp-page-main">
  <div class="container py-5">

    <%- include('../partials/flash') %>

    <!-- Profile card -->
    <div class="row justify-content-center">
      <div class="col-lg-7">

        <!-- Back link -->
        <a href="/students" class="cp-back-link mb-4 d-inline-flex align-items-center gap-1">
          <i class="bi bi-arrow-left"></i> Back to Students
        </a>

        <div class="cp-profile-card">
          <!-- Header -->
          <div class="cp-profile-header">
            <div class="cp-avatar" aria-hidden="true">
              <%= student.name.charAt(0).toUpperCase() %>
            </div>
            <div>
              <h1 class="cp-profile-name"><%= student.name %></h1>
              <span class="cp-profile-course">
                <i class="bi bi-book me-1"></i><%= student.course %>
              </span>
            </div>
          </div>

          <!-- Details -->
          <div class="cp-profile-body">
            <div class="row g-3">

              <div class="col-sm-6">
                <div class="cp-detail-item">
                  <span class="cp-detail-label">
                    <i class="bi bi-hash me-1"></i>Student ID
                  </span>
                  <span class="cp-detail-value">#<%= String(student.id).padStart(4, '0') %></span>
                </div>
              </div>

              <div class="col-sm-6">
                <div class="cp-detail-item">
                  <span class="cp-detail-label">
                    <i class="bi bi-mortarboard me-1"></i>Academic Level
                  </span>
                  <span class="cp-detail-value">
                    <%= student.course %> <%= student.year ? '• ' + student.year : '' %>
                  </span>
                </div>
              </div>

              <div class="col-sm-6">
                <div class="cp-detail-item">
                  <span class="cp-detail-label">
                    <i class="bi bi-envelope me-1"></i>Email
                  </span>
                  <span class="cp-detail-value">
                    <a href="mailto:<%= student.email %>" class="cp-detail-link"><%= student.email %></a>
                  </span>
                </div>
              </div>

              <div class="col-sm-6">
                <div class="cp-detail-item">
                  <span class="cp-detail-label">
                    <i class="bi bi-telephone me-1"></i>Phone
                  </span>
                  <span class="cp-detail-value"><%= student.phone %></span>
                </div>
              </div>

              <% if (student.dob) { %>
                <div class="col-sm-6">
                  <div class="cp-detail-item">
                    <span class="cp-detail-label">
                      <i class="bi bi-calendar-event me-1"></i>Date of Birth
                    </span>
                    <span class="cp-detail-value">
                      <%= student.dob %> <%= student.age !== null ? `(${student.age} years old)` : '' %>
                    </span>
                  </div>
                </div>
              <% } %>

              <% if (student.gender) { %>
                <div class="col-sm-6">
                  <div class="cp-detail-item">
                    <span class="cp-detail-label">
                      <i class="bi bi-person-check me-1"></i>Gender
                    </span>
                    <span class="cp-detail-value"><%= student.gender %></span>
                  </div>
                </div>
              <% } %>

              <% if (student.linkedin) { %>
                <div class="col-sm-6">
                  <div class="cp-detail-item">
                    <span class="cp-detail-label">
                      <i class="bi bi-linkedin text-info me-1"></i>LinkedIn Profile
                    </span>
                    <span class="cp-detail-value">
                      <a href="<%= student.linkedin %>" target="_blank" rel="noopener noreferrer" class="cp-detail-link">
                        <i class="bi bi-box-arrow-up-right me-1 small"></i>View Profile
                      </a>
                    </span>
                  </div>
                </div>
              <% } %>

              <div class="col-sm-6">
                <div class="cp-detail-item">
                  <span class="cp-detail-label">
                    <i class="bi bi-calendar me-1"></i>Registered On
                  </span>
                  <span class="cp-detail-value">
                    <%= new Date(student.createdAt).toLocaleDateString('en-IN', {
                      day: 'numeric', month: 'long', year: 'numeric'
                    }) %>
                  </span>
                </div>
              </div>

              <!-- Account Security Status (Task 4) -->
              <div class="col-sm-6">
                <div class="cp-detail-item">
                  <span class="cp-detail-label">
                    <i class="bi bi-shield-check me-1"></i>Account Credentials
                  </span>
                  <span class="cp-detail-value">
                    <% if (student.hasAccount) { %>
                      <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">
                        <i class="bi bi-check-circle-fill me-1"></i>Active (Bcrypt Encrypted)
                      </span>
                    <% } else { %>
                      <span class="badge bg-secondary bg-opacity-25 text-muted border border-secondary border-opacity-25">
                        Standard Enrolment
                      </span>
                    <% } %>
                  </span>
                </div>
              </div>

              <!-- Hostel / Accommodation (Task 4 Conditional) -->
              <% if (student.hostel) { %>
                <div class="col-12">
                  <div class="cp-detail-item border border-info border-opacity-25 p-3 rounded bg-info bg-opacity-10">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="fw-bold text-info">
                        <i class="bi bi-house-door-fill me-1"></i>Campus Hostel Allocation
                      </span>
                      <span class="badge bg-info text-dark fw-bold">Opted In</span>
                    </div>
                    <div class="row g-2 small">
                      <div class="col-sm-4 text-muted">Room Type:</div>
                      <div class="col-sm-8 text-white"><%= student.hostel.roomType %> Room</div>
                      <div class="col-sm-4 text-muted">Dietary Preference:</div>
                      <div class="col-sm-8 text-white"><%= student.hostel.dietary %></div>
                      <div class="col-sm-4 text-muted">Emergency Contact:</div>
                      <div class="col-sm-8 text-white"><%= student.hostel.emergencyContact %> (<%= student.hostel.emergencyPhone %>)</div>
                    </div>
                  </div>
                </div>
              <% } %>

              <!-- Scholarship Details (Task 4 Conditional) -->
              <% if (student.scholarship) { %>
                <div class="col-12">
                  <div class="cp-detail-item border border-warning border-opacity-25 p-3 rounded bg-warning bg-opacity-10">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="fw-bold text-warning">
                        <i class="bi bi-award-fill me-1"></i>Merit Scholarship Application
                      </span>
                      <span class="badge bg-warning text-dark fw-bold">Under Review</span>
                    </div>
                    <div class="row g-2 small">
                      <div class="col-sm-4 text-muted">Previous Score:</div>
                      <div class="col-sm-8 text-white"><%= student.scholarship.prevGpa %></div>
                      <div class="col-sm-4 text-muted">Family Income:</div>
                      <div class="col-sm-8 text-white"><%= student.scholarship.annualIncome %></div>
                    </div>
                  </div>
                </div>
              <% } %>

              <% if (student.message) { %>
                <div class="col-12">
                  <div class="cp-detail-item">
                    <span class="cp-detail-label">
                      <i class="bi bi-chat-text me-1"></i>Message
                    </span>
                    <span class="cp-detail-value cp-message-text"><%= student.message %></span>
                  </div>
                </div>
              <% } %>

            </div>
          </div>

          <!-- Actions -->
          <div class="cp-profile-footer d-flex flex-wrap gap-3">
            <a href="/students/register" class="btn cp-btn-primary">
              <i class="bi bi-person-plus me-2"></i>Register Another
            </a>
            <a href="/students" class="btn cp-btn-outline">
              <i class="bi bi-people me-2"></i>All Students
            </a>
          </div>
        </div>

      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
