<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main id="mainContent" class="cp-page-main">
  <div class="container py-5">

    <!-- Page header -->
    <div class="row justify-content-center mb-4">
      <div class="col-lg-7 text-center">
        <span class="cp-badge mb-2">
          <i class="bi bi-person-plus me-1"></i>New Enrolment
        </span>
        <h1 class="cp-page-title">Student Registration</h1>
        <p class="text-muted">
          Fill in the details below. All fields marked <span class="text-danger">*</span> are required.
          Your information is validated on the server before saving.
        </p>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-7">

        <%- include('../partials/flash') %>

        <!-- ── Validation error summary ──────────────────────── -->
        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger cp-error-summary" role="alert" id="errorSummary">
            <h2 class="alert-heading h6 mb-2">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
              Please fix the following <%= errors.length %> error<%= errors.length > 1 ? 's' : '' %>:
            </h2>
            <ul class="mb-0 ps-3">
              <% errors.forEach(e => { %>
                <li><a href="#field-<%= e.field %>" class="alert-link"><%= e.message %></a></li>
              <% }); %>
            </ul>
          </div>
        <% } %>

        <!-- ── Registration Form ──────────────────────────────── -->
        <div class="cp-form-card">
          <form
            action="/students/register"
            method="POST"
            id="registrationForm"
            novalidate
            aria-label="Student registration form"
          >
            <input type="hidden" name="formVersion" value="4" />

            <!-- SECTION 1: Personal Information -->
            <div class="cp-form-section mb-4">
              <h2 class="cp-section-title">
                <i class="bi bi-person-badge me-2 text-primary"></i>Personal Information
              </h2>

              <!-- Full Name -->
              <div class="mb-3" id="field-name">
                <label for="name" class="form-label cp-label">
                  Full Name <span class="text-danger" aria-label="required">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text cp-input-icon">
                    <i class="bi bi-person"></i>
                  </span>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    class="form-control cp-input <%= errors.some(e => e.field === 'name') ? 'is-invalid' : '' %>"
                    value="<%= old.name || '' %>"
                    placeholder="e.g. Priya Sharma"
                    maxlength="100"
                    autocomplete="name"
                    aria-required="true"
                    aria-describedby="nameError nameHelp"
                  />
                  <div class="invalid-feedback" id="nameError" role="alert">
                    <%= errors.find(e => e.field === 'name')?.message || '' %>
                  </div>
                </div>
                <small class="form-text text-muted" id="nameHelp">Letters, spaces, hyphens, and apostrophes only (2–100 characters).</small>
              </div>

              <!-- Email Address -->
              <div class="mb-3" id="field-email">
                <label for="email" class="form-label cp-label">
                  Email Address <span class="text-danger" aria-label="required">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text cp-input-icon">
                    <i class="bi bi-envelope"></i>
                  </span>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    class="form-control cp-input <%= errors.some(e => e.field === 'email') ? 'is-invalid' : '' %>"
                    value="<%= old.email || '' %>"
                    placeholder="e.g. name@domain.com or admin@cognifyz.com"
                    maxlength="254"
                    autocomplete="email"
                    aria-required="true"
                    aria-describedby="emailError emailHelp"
                  />
                  <div class="invalid-feedback" id="emailError" role="alert">
                    <%= errors.find(e => e.field === 'email')?.message || '' %>
                  </div>
                </div>
                <small class="form-text text-muted" id="emailHelp">Institutional or standard personal email (e.g., @gmail.com, @yahoo.com, @cognifyz.com).</small>
              </div>

              <!-- Date of Birth & Age -->
              <div class="row g-3 mb-3">
                <div class="col-md-7" id="field-dob">
                  <label for="dob" class="form-label cp-label">
                    Date of Birth <span class="text-danger" aria-label="required">*</span>
                  </label>
                  <div class="input-group">
                    <span class="input-group-text cp-input-icon">
                      <i class="bi bi-calendar-event"></i>
                    </span>
                    <input
                      type="date"
                      id="dob"
                      name="dob"
                      class="form-control cp-input <%= errors.some(e => e.field === 'dob') ? 'is-invalid' : '' %>"
                      value="<%= old.dob || '' %>"
                      aria-required="true"
                      aria-describedby="dobError dobHelp"
                    />
                    <div class="invalid-feedback" id="dobError" role="alert">
                      <%= errors.find(e => e.field === 'dob')?.message || '' %>
                    </div>
                  </div>
                  <small class="form-text text-muted" id="dobHelp">Must be at least 16 years of age.</small>
                </div>
                <div class="col-md-5 d-flex flex-column justify-content-end">
                  <div class="cp-age-badge-box p-2 rounded text-center border border-secondary border-opacity-25 bg-dark bg-opacity-50">
                    <small class="text-muted d-block">Calculated Age</small>
                    <span id="ageBadge" class="fw-bold text-info">—</span>
                  </div>
                </div>
              </div>

              <!-- Gender -->
              <div class="mb-3" id="field-gender">
                <label class="form-label cp-label d-block">
                  Gender <span class="text-danger" aria-label="required">*</span>
                </label>
                <div class="cp-radio-group d-flex flex-wrap gap-2">
                  <% [
                    { val: 'Male', icon: 'bi-gender-male' },
                    { val: 'Female', icon: 'bi-gender-female' },
                    { val: 'Other', icon: 'bi-gender-ambiguous' },
                    { val: 'Prefer not to say', icon: 'bi-shield-check' }
                  ].forEach(g => { %>
                    <label class="cp-pill-radio <%= old.gender === g.val ? 'active' : '' %>">
                      <input
                        type="radio"
                        name="gender"
                        value="<%= g.val %>"
                        <%= old.gender === g.val ? 'checked' : '' %>
                        aria-required="true"
                      />
                      <i class="bi <%= g.icon %> me-1"></i><%= g.val %>
                    </label>
                  <% }); %>
                </div>
                <% if (errors.some(e => e.field === 'gender')) { %>
                  <div class="text-danger small mt-1" id="genderError" role="alert">
                    <%= errors.find(e => e.field === 'gender').message %>
                  </div>
                <% } else { %>
                  <div class="text-danger small mt-1 d-none" id="genderError" role="alert"></div>
                <% } %>
              </div>
            </div>

            <!-- SECTION 2: Academic Details -->
            <div class="cp-form-section mb-4 pt-3 border-top border-secondary border-opacity-25">
              <h2 class="cp-section-title">
                <i class="bi bi-mortarboard me-2 text-primary"></i>Academic Details
              </h2>

              <div class="row g-3">
                <!-- Course -->
                <div class="col-md-7" id="field-course">
                  <label for="course" class="form-label cp-label">
                    Course / Major <span class="text-danger" aria-label="required">*</span>
                  </label>
                  <div class="input-group">
                    <span class="input-group-text cp-input-icon">
                      <i class="bi bi-book"></i>
                    </span>
                    <select
                      id="course"
                      name="course"
                      class="form-select cp-input <%= errors.some(e => e.field === 'course') ? 'is-invalid' : '' %>"
                      aria-required="true"
                      aria-describedby="courseError"
                    >
                      <option value="" disabled <%= !old.course ? 'selected' : '' %>>— Select your course —</option>
                      <% [
                        'Computer Science',
                        'Information Technology',
                        'Data Science',
                        'Artificial Intelligence',
                        'Cybersecurity',
                        'Software Engineering',
                        'Web Development',
                        'Other',
                      ].forEach(c => { %>
                        <option value="<%= c %>" <%= old.course === c ? 'selected' : '' %>><%= c %></option>
                      <% }); %>
                    </select>
                    <div class="invalid-feedback" id="courseError" role="alert">
                      <%= errors.find(e => e.field === 'course')?.message || '' %>
                    </div>
                  </div>
                </div>

                <!-- Year of Study -->
                <div class="col-md-5" id="field-year">
                  <label for="year" class="form-label cp-label">
                    Year of Study <span class="text-danger" aria-label="required">*</span>
                  </label>
                  <div class="input-group">
                    <span class="input-group-text cp-input-icon">
                      <i class="bi bi-calendar3"></i>
                    </span>
                    <select
                      id="year"
                      name="year"
                      class="form-select cp-input <%= errors.some(e => e.field === 'year') ? 'is-invalid' : '' %>"
                      aria-required="true"
                      aria-describedby="yearError"
                    >
                      <option value="" disabled <%= !old.year ? 'selected' : '' %>>— Select Year —</option>
                      <% [
                        '1st Year',
                        '2nd Year',
                        '3rd Year',
                        '4th Year',
                        'Postgraduate'
                      ].forEach(y => { %>
                        <option value="<%= y %>" <%= old.year === y ? 'selected' : '' %>><%= y %></option>
                      <% }); %>
                    </select>
                    <div class="invalid-feedback" id="yearError" role="alert">
                      <%= errors.find(e => e.field === 'year')?.message || '' %>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- SECTION 3: Contact & Online Presence -->
            <div class="cp-form-section mb-4 pt-3 border-top border-secondary border-opacity-25">
              <h2 class="cp-section-title">
                <i class="bi bi-telephone-inbound me-2 text-primary"></i>Contact & Profiles
              </h2>

              <!-- Phone Number -->
              <div class="mb-3" id="field-phone">
                <label for="phone" class="form-label cp-label">
                  Phone Number <span class="text-danger" aria-label="required">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text cp-input-icon">
                    <i class="bi bi-telephone"></i>
                  </span>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    class="form-control cp-input <%= errors.some(e => e.field === 'phone') ? 'is-invalid' : '' %>"
                    value="<%= old.phone || '' %>"
                    placeholder="e.g. +91 98765 43210"
                    maxlength="20"
                    autocomplete="tel"
                    aria-required="true"
                    aria-describedby="phoneError phoneHelp"
                  />
                  <div class="invalid-feedback" id="phoneError" role="alert">
                    <%= errors.find(e => e.field === 'phone')?.message || '' %>
                  </div>
                </div>
                <small class="form-text text-muted" id="phoneHelp">7 to 15 digits (country code optional).</small>
              </div>

              <!-- LinkedIn Profile (Optional) -->
              <div class="mb-3" id="field-linkedin">
                <label for="linkedin" class="form-label cp-label">
                  LinkedIn Profile <span class="text-muted fw-normal">(optional)</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text cp-input-icon">
                    <i class="bi bi-linkedin text-info"></i>
                  </span>
                  <input
                    type="url"
                    id="linkedin"
                    name="linkedin"
                    class="form-control cp-input <%= errors.some(e => e.field === 'linkedin') ? 'is-invalid' : '' %>"
                    value="<%= old.linkedin || '' %>"
                    placeholder="https://linkedin.com/in/username"
                    maxlength="200"
                    autocomplete="url"
                    aria-describedby="linkedinError linkedinHelp"
                  />
                  <div class="invalid-feedback" id="linkedinError" role="alert">
                    <%= errors.find(e => e.field === 'linkedin')?.message || '' %>
                  </div>
                </div>
                <small class="form-text text-muted" id="linkedinHelp">e.g. https://linkedin.com/in/yourname</small>
              </div>

              <!-- Message (optional) -->
              <div class="mb-3" id="field-message">
                <label for="message" class="form-label cp-label">
                  Additional Notes / Motivation <span class="text-muted fw-normal">(optional)</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  class="form-control cp-input <%= errors.some(e => e.field === 'message') ? 'is-invalid' : '' %>"
                  rows="3"
                  placeholder="Share any special goals, portfolio links, or questions..."
                  maxlength="500"
                  aria-describedby="messageError messageCount"
                ><%= old.message || '' %></textarea>
                <div class="d-flex justify-content-between mt-1">
                  <div class="invalid-feedback" id="messageError" role="alert">
                    <%= errors.find(e => e.field === 'message')?.message || '' %>
                  </div>
                  <small class="text-muted ms-auto" id="messageCount" aria-live="polite">
                    0 / 500
                  </small>
                </div>
              </div>
            </div>

            <!-- SECTION 4: Account Security & Credentials (Task 4) -->
            <div class="cp-form-section mb-4 pt-3 border-top border-secondary border-opacity-25" id="section-security">
              <h2 class="cp-section-title">
                <i class="bi bi-shield-lock me-2 text-primary"></i>Account Security &amp; Portal Password
              </h2>
              <p class="text-muted small mb-3">
                Create a strong password to securely access your student profile and learning materials.
              </p>

              <!-- Password -->
              <div class="mb-3" id="field-password">
                <label for="password" class="form-label cp-label">
                  Create Password <span class="text-danger" aria-label="required">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text cp-input-icon">
                    <i class="bi bi-key"></i>
                  </span>
                  <input
                    type="password"
                    id="password"
                    name="password"
                    value="<%= old.password || '' %>"
                    class="form-control cp-input <%= errors.some(e => e.field === 'password') ? 'is-invalid' : '' %>"
                    placeholder="Enter secure password"
                    autocomplete="new-password"
                    aria-required="true"
                    aria-describedby="passwordError passwordStrengthLabel"
                  />
                  <button
                    class="btn btn-outline-secondary border-0 cp-toggle-pw"
                    type="button"
                    id="togglePasswordBtn"
                    title="Toggle password visibility"
                    aria-label="Toggle password visibility"
                  >
                    <i class="bi bi-eye"></i>
                  </button>
                  <div class="invalid-feedback" id="passwordError" role="alert">
                    <%= errors.find(e => e.field === 'password')?.message || '' %>
                  </div>
                </div>

                <!-- Password strength bar & label -->
                <div class="mt-2">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <small class="text-muted">Password Strength:</small>
                    <small id="passwordStrengthLabel" class="fw-bold text-muted">Enter password</small>
                  </div>
                  <div class="progress cp-password-progress" style="height: 6px; background: rgba(255,255,255,0.08);">
                    <div
                      id="passwordStrengthBar"
                      class="progress-bar bg-danger"
                      role="progressbar"
                      style="width: 0%; transition: width 0.3s ease;"
                      aria-valuenow="0"
                      aria-valuemin="0"
                      aria-valuemax="100"
                    ></div>
                  </div>
                </div>

                <!-- Dynamic Security Checklist -->
                <div class="cp-password-checklist mt-3 p-3 rounded border border-secondary border-opacity-25 bg-dark bg-opacity-25">
                  <small class="text-muted fw-bold d-block mb-2">Requirements:</small>
                  <div class="row g-2 small">
                    <div class="col-sm-6" id="chkMinLength">
                      <i class="bi bi-circle text-muted me-1"></i> At least 8 characters
                    </div>
                    <div class="col-sm-6" id="chkUpper">
                      <i class="bi bi-circle text-muted me-1"></i> Uppercase letter (A-Z)
                    </div>
                    <div class="col-sm-6" id="chkLower">
                      <i class="bi bi-circle text-muted me-1"></i> Lowercase letter (a-z)
                    </div>
                    <div class="col-sm-6" id="chkDigit">
                      <i class="bi bi-circle text-muted me-1"></i> Number (0-9)
                    </div>
                    <div class="col-sm-6" id="chkSpecial">
                      <i class="bi bi-circle text-muted me-1"></i> Special symbol (!@#$%^&*)
                    </div>
                    <div class="col-sm-6" id="chkMatch">
                      <i class="bi bi-circle text-muted me-1"></i> Passwords match
                    </div>
                  </div>
                </div>
              </div>

              <!-- Confirm Password -->
              <div class="mb-3" id="field-confirmPassword">
                <label for="confirmPassword" class="form-label cp-label">
                  Confirm Password <span class="text-danger" aria-label="required">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text cp-input-icon">
                    <i class="bi bi-check2-circle"></i>
                  </span>
                  <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    value="<%= old.confirmPassword || '' %>"
                    class="form-control cp-input <%= errors.some(e => e.field === 'confirmPassword') ? 'is-invalid' : '' %>"
                    placeholder="Re-enter your password"
                    autocomplete="new-password"
                    aria-required="true"
                    aria-describedby="confirmPasswordError"
                  />
                  <button
                    class="btn btn-outline-secondary border-0 cp-toggle-pw"
                    type="button"
                    id="toggleConfirmPasswordBtn"
                    title="Toggle confirm password visibility"
                    aria-label="Toggle confirm password visibility"
                  >
                    <i class="bi bi-eye"></i>
                  </button>
                  <div class="invalid-feedback" id="confirmPasswordError" role="alert">
                    <%= errors.find(e => e.field === 'confirmPassword')?.message || '' %>
                  </div>
                </div>
              </div>
            </div>

            <!-- SECTION 5: Conditional Campus Facilities (Task 4) -->
            <div class="cp-form-section mb-4 pt-3 border-top border-secondary border-opacity-25" id="section-facilities">
              <h2 class="cp-section-title">
                <i class="bi bi-buildings me-2 text-primary"></i>Campus Facilities &amp; Aid
              </h2>

              <!-- Toggle 1: Hostel / Accommodation -->
              <div class="cp-conditional-card p-3 rounded border border-secondary border-opacity-25 bg-dark bg-opacity-25 mb-3">
                <div class="form-check form-switch mb-0">
                  <input
                    class="form-check-input cp-switch"
                    type="checkbox"
                    id="requiresHostelToggle"
                    name="requiresHostel"
                    <%= (old.requiresHostel === 'on' || old.requiresHostel === 'true' || old.requiresHostel === true) ? 'checked' : '' %>
                  />
                  <label class="form-check-label fw-bold text-white ms-2" for="requiresHostelToggle">
                    <i class="bi bi-house-door me-1 text-info"></i>Request Campus Hostel / Accommodation
                  </label>
                </div>
                <small class="text-muted d-block ms-5 mt-1">Check this if you require on-campus residential boarding.</small>

                <!-- Sub-Form: Hostel Details (conditionally revealed) -->
                <div id="hostelDetailsContainer" class="mt-3 pt-3 border-top border-secondary border-opacity-25 <%= (old.requiresHostel === 'on' || old.requiresHostel === 'true' || old.requiresHostel === true) ? '' : 'd-none' %>">
                  <div class="row g-3">
                    <div class="col-md-6" id="field-roomType">
                      <label for="roomType" class="form-label cp-label">Room Preference <span class="text-danger">*</span></label>
                      <select id="roomType" name="roomType" class="form-select cp-input">
                        <% ['Single', 'Double', 'Triple', 'Suite'].forEach(r => { %>
                          <option value="<%= r %>" <%= old.roomType === r ? 'selected' : '' %>><%= r %> Room</option>
                        <% }); %>
                      </select>
                    </div>

                    <div class="col-md-6" id="field-dietary">
                      <label for="dietary" class="form-label cp-label">Dietary Preference <span class="text-danger">*</span></label>
                      <select id="dietary" name="dietary" class="form-select cp-input">
                        <% ['Vegetarian', 'Non-Vegetarian', 'Vegan'].forEach(d => { %>
                          <option value="<%= d %>" <%= old.dietary === d ? 'selected' : '' %>><%= d %></option>
                        <% }); %>
                      </select>
                    </div>

                    <div class="col-md-6" id="field-emergencyContact">
                      <label for="emergencyContact" class="form-label cp-label">Emergency Contact Name <span class="text-danger">*</span></label>
                      <input
                        type="text"
                        id="emergencyContact"
                        name="emergencyContact"
                        class="form-control cp-input <%= errors.some(e => e.field === 'emergencyContact') ? 'is-invalid' : '' %>"
                        value="<%= old.emergencyContact || '' %>"
                        placeholder="e.g. Ramesh Sharma (Father)"
                      />
                      <div class="invalid-feedback" id="emergencyContactError">
                        <%= errors.find(e => e.field === 'emergencyContact')?.message || '' %>
                      </div>
                    </div>

                    <div class="col-md-6" id="field-emergencyPhone">
                      <label for="emergencyPhone" class="form-label cp-label">Emergency Contact Phone <span class="text-danger">*</span></label>
                      <input
                        type="tel"
                        id="emergencyPhone"
                        name="emergencyPhone"
                        class="form-control cp-input <%= errors.some(e => e.field === 'emergencyPhone') ? 'is-invalid' : '' %>"
                        value="<%= old.emergencyPhone || '' %>"
                        placeholder="e.g. +91 98111 22233"
                      />
                      <div class="invalid-feedback" id="emergencyPhoneError">
                        <%= errors.find(e => e.field === 'emergencyPhone')?.message || '' %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Toggle 2: Scholarship Application -->
              <div class="cp-conditional-card p-3 rounded border border-secondary border-opacity-25 bg-dark bg-opacity-25">
                <div class="form-check form-switch mb-0">
                  <input
                    class="form-check-input cp-switch"
                    type="checkbox"
                    id="appliesScholarshipToggle"
                    name="appliesScholarship"
                    <%= (old.appliesScholarship === 'on' || old.appliesScholarship === 'true' || old.appliesScholarship === true) ? 'checked' : '' %>
                  />
                  <label class="form-check-label fw-bold text-white ms-2" for="appliesScholarshipToggle">
                    <i class="bi bi-award me-1 text-warning"></i>Apply for Merit Scholarship / Financial Aid
                  </label>
                </div>
                <small class="text-muted d-block ms-5 mt-1">Students with >= 6.0 CGPA or >= 60% are eligible for tuition assistance.</small>

                <!-- Sub-Form: Scholarship Details (conditionally revealed) -->
                <div id="scholarshipDetailsContainer" class="mt-3 pt-3 border-top border-secondary border-opacity-25 <%= (old.appliesScholarship === 'on' || old.appliesScholarship === 'true' || old.appliesScholarship === true) ? '' : 'd-none' %>">
                  <div class="row g-3">
                    <div class="col-md-6" id="field-prevGpa">
                      <label for="prevGpa" class="form-label cp-label">Previous Score (CGPA or %) <span class="text-danger">*</span></label>
                      <input
                        type="text"
                        id="prevGpa"
                        name="prevGpa"
                        class="form-control cp-input <%= errors.some(e => e.field === 'prevGpa') ? 'is-invalid' : '' %>"
                        value="<%= old.prevGpa || '' %>"
                        placeholder="e.g. 8.5 CGPA or 85%"
                      />
                      <div class="invalid-feedback" id="prevGpaError">
                        <%= errors.find(e => e.field === 'prevGpa')?.message || '' %>
                      </div>
                    </div>

                    <div class="col-md-6" id="field-annualIncome">
                      <label for="annualIncome" class="form-label cp-label">Family Annual Income <span class="text-danger">*</span></label>
                      <select id="annualIncome" name="annualIncome" class="form-select cp-input">
                        <% ['< 2.5 LPA', '2.5 - 5 LPA', '5 - 8 LPA', '> 8 LPA'].forEach(inc => { %>
                          <option value="<%= inc %>" <%= old.annualIncome === inc ? 'selected' : '' %>><%= inc %></option>
                        <% }); %>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Terms & Conditions / Privacy Policy Agreement -->
            <div class="mt-4 mb-2 form-check">
              <input
                type="checkbox"
                class="form-check-input"
                id="studentAgreeTerms"
                name="agreeTerms"
                value="on"
                required
              />
              <label class="form-check-label small text-muted" for="studentAgreeTerms">
                I agree to the <a href="/terms" target="_blank" class="text-primary">Terms &amp; Conditions</a> and <a href="/privacy" target="_blank" class="text-primary">Privacy Policy</a> <span class="text-danger">*</span>
              </label>
            </div>

            <!-- Submit Buttons -->
            <div class="d-grid gap-2 mt-4 pt-2 border-top border-secondary border-opacity-25">
              <button type="button" class="btn cp-btn-primary btn-lg" id="reviewSubmitBtn">
                <i class="bi bi-shield-check me-2"></i>Review &amp; Submit Registration
              </button>
              <button type="submit" class="btn cp-btn-primary btn-lg d-none" id="submitBtn">
                <i class="bi bi-send me-2"></i>Submit Registration
              </button>
              <a href="/" class="btn cp-btn-ghost">Cancel</a>
            </div>

          </form>
        </div>
        <!-- end form card -->

        <!-- ── Confirmation Modal (Task 4) ────────────────────── -->
        <div class="modal fade" id="confirmSubmitModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cp-form-card border border-secondary border-opacity-50">
              <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title text-white" id="confirmModalLabel">
                  <i class="bi bi-patch-check-fill text-primary me-2"></i>Confirm Student Registration
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body text-start">
                <p class="text-muted small">Please verify your details before final submission:</p>
                <div class="p-3 rounded bg-dark bg-opacity-50 border border-secondary border-opacity-25 mb-3">
                  <div class="row g-2 small">
                    <div class="col-4 text-muted">Full Name:</div>
                    <div class="col-8 text-white fw-bold" id="modalReviewName">—</div>
                    <div class="col-4 text-muted">Email:</div>
                    <div class="col-8 text-white" id="modalReviewEmail">—</div>
                    <div class="col-4 text-muted">Academic:</div>
                    <div class="col-8 text-white" id="modalReviewCourse">—</div>
                    <div class="col-4 text-muted">Phone:</div>
                    <div class="col-8 text-white" id="modalReviewPhone">—</div>
                    <div class="col-4 text-muted">Hostel:</div>
                    <div class="col-8 text-info" id="modalReviewHostel">Not requested</div>
                    <div class="col-4 text-muted">Scholarship:</div>
                    <div class="col-8 text-warning" id="modalReviewScholarship">Not requested</div>
                  </div>
                </div>
                <div class="alert alert-info py-2 small mb-0">
                  <i class="bi bi-info-circle me-1"></i> Your password will be securely encrypted using <strong>bcrypt</strong> before saving.
                </div>
              </div>
              <div class="modal-footer border-secondary border-opacity-25">
                <button type="button" class="btn cp-btn-ghost" data-bs-dismiss="modal">Make Changes</button>
                <button type="button" class="btn cp-btn-primary" id="modalFinalSubmitBtn">
                  <i class="bi bi-check-circle me-1"></i>Confirm &amp; Register
                </button>
              </div>
            </div>
          </div>
        </div>


      </div>
    </div>
  </div>
</main>

