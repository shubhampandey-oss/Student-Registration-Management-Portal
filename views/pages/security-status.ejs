<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main id="mainContent" class="cp-page-main">
  <div class="container py-5">

    <div class="row justify-content-center mb-4">
      <div class="col-lg-10">
        <%- include('../partials/flash') %>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
          <div>
            <span class="cp-badge mb-2 bg-success text-white">
              <i class="bi bi-shield-check me-1"></i>Security & Performance
            </span>
            <h1 class="cp-page-title mb-1">Security & System Diagnostics</h1>
            <p class="text-muted mb-0">Live status of Helmet HTTP headers, express-rate-limit, and node-cache engine.</p>
          </div>
          <div class="d-flex gap-2">
            <a href="/auth/dashboard" class="btn btn-outline-secondary">
              <i class="bi bi-arrow-left me-1"></i>Dashboard
            </a>
            <form action="/auth/security/flush-cache" method="POST" class="d-inline">
              <button type="submit" class="btn btn-warning">
                <i class="bi bi-arrow-repeat me-1"></i>Flush Cache
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Diagnostics Grid ────────────────────────────────────────── -->
    <div class="row justify-content-center">
      <div class="col-lg-10">

        <!-- 1. Cache Telemetry Card -->
        <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h5 fw-bold mb-0">
              <i class="bi bi-lightning-charge-fill text-warning me-2"></i>In-Memory Cache Telemetry (node-cache)
            </h2>
            <span class="badge bg-primary rounded-pill">TTL: 60s</span>
          </div>

          <div class="row g-3">
            <div class="col-md-3 col-6">
              <div class="p-3 bg-light rounded-3 text-center">
                <span class="text-muted small d-block">Cache Hits</span>
                <strong class="fs-4 text-success" id="statHits"><%= cacheStats.hits %></strong>
              </div>
            </div>
            <div class="col-md-3 col-6">
              <div class="p-3 bg-light rounded-3 text-center">
                <span class="text-muted small d-block">Cache Misses</span>
                <strong class="fs-4 text-secondary" id="statMisses"><%= cacheStats.misses %></strong>
              </div>
            </div>
            <div class="col-md-3 col-6">
              <div class="p-3 bg-light rounded-3 text-center">
                <span class="text-muted small d-block">Hit Ratio</span>
                <strong class="fs-4 text-primary" id="statRatio"><%= cacheStats.hitRatio %></strong>
              </div>
            </div>
            <div class="col-md-3 col-6">
              <div class="p-3 bg-light rounded-3 text-center">
                <span class="text-muted small d-block">Active Keys</span>
                <strong class="fs-4 text-dark" id="statKeys"><%= cacheStats.keys %></strong>
              </div>
            </div>
          </div>

          <div class="mt-3 p-3 bg-light rounded-3 border">
            <span class="small fw-semibold text-secondary d-block mb-1">
              <i class="bi bi-tag me-1"></i>Cached Endpoint Keys:
            </span>
            <% if (cacheStats.activeKeys && cacheStats.activeKeys.length > 0) { %>
              <div class="d-flex flex-wrap gap-1">
                <% cacheStats.activeKeys.forEach(k => { %>
                  <code class="badge bg-white text-dark border"><%= k %></code>
                <% }); %>
              </div>
            <% } else { %>
              <span class="text-muted small fst-italic">No active keys currently in cache. Visit /api/v1/students to populate.</span>
            <% } %>
          </div>
        </div>

        <!-- 2. Security Headers & Rate Limiters Card -->
        <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
          <h2 class="h5 fw-bold mb-3">
            <i class="bi bi-shield-lock-fill text-primary me-2"></i>Security Headers & Defense Policies
          </h2>

          <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Protection Layer</th>
                  <th>Module / Standard</th>
                  <th>Configured Policy</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Content Security Policy (CSP)</strong></td>
                  <td><code>helmet</code></td>
                  <td>Restricts script/style execution to self, CDN, and Google Fonts</td>
                  <td><span class="badge bg-success">Enforced</span></td>
                </tr>
                <tr>
                  <td><strong>Clickjacking Defense</strong></td>
                  <td><code>helmet (X-Frame-Options)</code></td>
                  <td><code>SAMEORIGIN</code> — Blocks cross-site framing</td>
                  <td><span class="badge bg-success">Enforced</span></td>
                </tr>
                <tr>
                  <td><strong>MIME Sniffing Prevention</strong></td>
                  <td><code>helmet (nosniff)</code></td>
                  <td><code>X-Content-Type-Options: nosniff</code></td>
                  <td><span class="badge bg-success">Enforced</span></td>
                </tr>
                <tr>
                  <td><strong>Cross-Site Scripting (XSS)</strong></td>
                  <td>Custom Sanitizer Middleware</td>
                  <td>Strips script tags, event handlers, and javascript: protocols</td>
                  <td><span class="badge bg-success">Active</span></td>
                </tr>
                <tr>
                  <td><strong>Brute-Force Rate Limiting</strong></td>
                  <td><code>express-rate-limit</code></td>
                  <td>10 login attempts / 15m; 120 API requests / 15m</td>
                  <td><span class="badge bg-success">Active</span></td>
                </tr>
                <tr>
                  <td><strong>Password Encryption</strong></td>
                  <td><code>bcrypt</code></td>
                  <td>Salt Rounds: 10 with automatic hash stripping</td>
                  <td><span class="badge bg-success">Enforced</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
