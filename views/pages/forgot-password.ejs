<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main id="mainContent" class="cp-page-main">
  <div class="container py-5">

    <!-- Page Header -->
    <div class="row justify-content-center mb-4">
      <div class="col-lg-6 text-center">
        <span class="cp-badge mb-2" id="recoveryBadge">
          <i class="bi bi-shield-lock me-1 text-primary"></i>Password Recovery
        </span>
        <h1 class="cp-page-title" id="recoveryTitle">Forgot Password</h1>
        <p class="text-muted" id="recoverySubtitle">
          Enter your registered email address to verify your account and continue to reset your password.
        </p>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-5 col-md-8">

        <%- include('../partials/flash') %>

        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger cp-error-summary mb-4" role="alert" id="errorSummary">
            <h2 class="alert-heading h6 mb-2">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>Please fix the following:
            </h2>
            <ul class="mb-0 ps-3">
              <% errors.forEach(e => { %>
                <li><%= e.msg || e.message %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>

        <!-- Forgot Password Card -->
        <div class="cp-form-card shadow-sm p-4 rounded-4 bg-white border" id="forgotCard">
          <form action="/auth/forgot-password" method="POST" id="forgotPasswordForm" novalidate>

            <!-- Registered Email Field -->
            <div class="mb-4">
              <label for="forgotEmail" class="form-label cp-label fw-semibold">
                <i class="bi bi-envelope me-1 text-primary"></i>Registered Email Address <span class="text-danger">*</span>
              </label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                  <i class="bi bi-at text-muted"></i>
                </span>
                <input
                  type="email"
                  class="form-control form-control-lg border-start-0 <%= errors.find(e => e.field === 'email') ? 'is-invalid' : '' %>"
                  id="forgotEmail"
                  name="email"
                  placeholder="e.g. name@domain.com or admin@cognifyz.com"
                  value="<%= old && old.email ? old.email : '' %>"
                  required
                  autocomplete="email"
                />
              </div>
              <div class="invalid-feedback <%= errors.find(e => e.field === 'email') ? 'd-block' : '' %>">
                <%= errors.find(e => e.field === 'email')?.msg || errors.find(e => e.field === 'email')?.message || 'Please enter a valid registered email address.' %>
              </div>
              <small class="form-text text-muted">We will verify that your email is registered before proceeding to reset your password.</small>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="btn btn-primary btn-lg w-100 fw-semibold mb-3 shadow-sm"
              id="submitForgotBtn"
            >
              <i class="bi bi-arrow-right-circle me-2"></i>Verify Email &amp; Continue
            </button>
          </form>

          <!-- Back to login -->
          <div class="text-center mt-3 border-top pt-3">
            <span class="text-muted">Remembered your password?</span>
            <a href="/auth/login" class="fw-semibold text-primary ms-1">
              <i class="bi bi-box-arrow-in-left me-1"></i>Back to Sign In
            </a>
          </div>
        </div>

      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
