<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main id="mainContent" class="cp-page-main">
  <div class="container py-5">

    <div class="row justify-content-center mb-4">
      <div class="col-lg-10">
        <%- include('../partials/flash') %>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
          <div>
            <span class="cp-badge mb-2 bg-danger text-white">
              <i class="bi bi-shield-shaded me-1"></i>Admin Access Only
            </span>
            <h1 class="cp-page-title mb-1">Administrator Console</h1>
            <p class="text-muted mb-0">System management, database status, and user registry.</p>
          </div>
          <div class="d-flex gap-2">
            <a href="/auth/dashboard" class="btn btn-outline-secondary">
              <i class="bi bi-arrow-left me-1"></i>Dashboard
            </a>
            <a href="/students" class="btn btn-primary">
              <i class="bi bi-people me-1"></i>Student Directory
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h5 fw-bold mb-0">
              <i class="bi bi-people-fill me-2 text-primary"></i>Registered System Users
            </h2>
            <span class="badge bg-secondary rounded-pill"><%= users.length %> Users</span>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col">ID</th>
                  <th scope="col">User</th>
                  <th scope="col">Email</th>
                  <th scope="col">Role</th>
                  <th scope="col">Registered At</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(u => { %>
                  <tr>
                    <td><strong>#<%= u.id %></strong></td>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle fs-5 <%= u.role === 'admin' ? 'text-danger' : 'text-primary' %>"></i>
                        <span><%= u.name %></span>
                      </div>
                    </td>
                    <td><code><%= u.email %></code></td>
                    <td>
                      <span class="badge <%= u.role === 'admin' ? 'bg-danger' : 'bg-success' %> text-uppercase">
                        <%= u.role %>
                      </span>
                    </td>
                    <td class="text-muted small">
                      <%= new Date(u.createdAt).toLocaleDateString('en-GB') %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
