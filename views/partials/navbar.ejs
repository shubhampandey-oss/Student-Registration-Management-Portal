<!-- ── Navigation Bar ──────────────────────────────────────────── -->
<nav class="navbar navbar-expand-lg navbar-dark cp-navbar sticky-top" id="mainNav" aria-label="Main navigation">
  <div class="container">

    <!-- Brand -->
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <span class="cp-brand-icon">
        <i class="bi bi-mortarboard-fill"></i>
      </span>
      <span class="fw-700">Cognifyz<span class="cp-brand-accent"> Portal</span></span>
    </a>

    <!-- Mobile toggle -->
    <button
      class="navbar-toggler border-0"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarContent"
      aria-controls="navbarContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Nav links -->
    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
        <li class="nav-item">
          <a class="nav-link" href="/"><i class="bi bi-house-door me-1"></i>Home</a>
        </li>
        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
          <li class="nav-item">
            <a class="nav-link" href="/students"><i class="bi bi-people me-1"></i>Students (Admin)</a>
          </li>
        <% } %>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <li class="nav-item">
            <a class="nav-link nav-cta" href="/students/register" id="navRegisterStudentBtn">
              <i class="bi bi-person-plus me-1"></i>+ Register Student
            </a>
          </li>
        <% } %>
      </ul>

      <!-- User Authentication Controls -->
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-2">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <!-- User Profile Badge -->
          <li class="nav-item">
            <a
              class="nav-link d-flex align-items-center gap-2 py-1 px-3 rounded-pill bg-light bg-opacity-10 text-white border border-light border-opacity-10 text-decoration-none shadow-sm"
              href="<%= currentUser.role === 'admin' ? '/auth/admin' : '/auth/dashboard' %>"
              title="Click to view account details"
            >
              <i class="bi <%= currentUser.role === 'admin' ? 'bi-shield-check text-warning' : 'bi-person-circle text-info' %> fs-5"></i>
              <span class="fw-semibold"><%= currentUser.name %></span>
              <span class="badge <%= currentUser.role === 'admin' ? 'bg-danger' : 'bg-info text-dark' %> text-uppercase" style="font-size: 0.65rem;">
                <%= currentUser.role %>
              </span>
            </a>
          </li>

          <!-- Dedicated Direct Log Out Button -->
          <li class="nav-item">
            <a
              href="/auth/logout"
              class="btn btn-sm btn-outline-danger d-flex align-items-center gap-2 rounded-pill px-3 py-1 fw-semibold shadow-sm"
              id="<%= currentUser.role === 'admin' ? 'adminLogoutBtn' : 'userLogoutBtn' %>"
              title="<%= currentUser.role === 'admin' ? 'Click to log out of Admin account' : 'Click to log out of User account' %>"
            >
              <i class="bi bi-box-arrow-right"></i>
              <span><%= currentUser.role === 'admin' ? 'Admin Log Out' : 'User Log Out' %></span>
            </a>
          </li>
        <% } else { %>
          <!-- Sign In Portal Options -->
          <li class="nav-item dropdown">
            <a
              class="nav-link text-white dropdown-toggle d-flex align-items-center gap-1 px-2"
              href="/auth/login"
              id="navLoginBtn"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <i class="bi bi-box-arrow-in-right"></i>
              <span class="fw-semibold">Sign In</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3" aria-labelledby="navLoginBtn">
              <li><h6 class="dropdown-header text-uppercase tracking-wider small">Select Interface</h6></li>
              <li>
                <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="/auth/login?portal=student" id="navStudentLoginBtn">
                  <i class="bi bi-person-badge text-primary fs-5"></i>
                  <div>
                    <strong class="d-block text-dark">Student Sign In</strong>
                    <small class="text-muted">Student dashboard & profile</small>
                  </div>
                </a>
              </li>
              <li><hr class="dropdown-divider my-1" /></li>
              <li>
                <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="/auth/login?portal=admin" id="navAdminLoginBtn">
                  <i class="bi bi-shield-lock text-danger fs-5"></i>
                  <div>
                    <strong class="d-block text-dark">Admin Sign In</strong>
                    <small class="text-muted">Inspect students & records</small>
                  </div>
                </a>
              </li>
            </ul>
          </li>

          <!-- Standard Sign Up -->
          <li class="nav-item">
            <a class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 fw-semibold d-flex align-items-center gap-1 shadow-sm" href="/auth/register" id="navRegisterBtn">
              <i class="bi bi-person-plus"></i>
              <span>Sign Up</span>
            </a>
          </li>
        <% } %>
      </ul>
    </div>

  </div>
</nav>
<!-- ── End Navbar ───────────────────────────────────────────────── -->
