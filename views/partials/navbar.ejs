<!-- ── Navigation Bar ──────────────────────────────────────────── -->
<nav class="navbar navbar-expand-lg navbar-dark cp-navbar sticky-top" id="mainNav" aria-label="Main navigation">
  <div class="container">

    <!-- Brand -->
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <span class="cp-brand-icon">
        <i class="bi bi-mortarboard-fill"></i>
      </span>
      <span class="fw-700">Cognifyz<span class="cp-brand-accent"> Portal</span></span>
    </a>

    <!-- Mobile toggle -->
    <button
      class="navbar-toggler border-0"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarContent"
      aria-controls="navbarContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Nav links -->
    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
        <li class="nav-item">
          <a class="nav-link" href="/"><i class="bi bi-house-door me-1"></i>Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/students"><i class="bi bi-people me-1"></i>Students</a>
        </li>
        <li class="nav-item">
          <a class="nav-link nav-cta" href="/students/register">
            <i class="bi bi-person-plus me-1"></i>Register Student
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/api/docs"><i class="bi bi-code-slash me-1"></i>API Docs</a>
        </li>
      </ul>

      <!-- User Authentication Controls -->
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-2">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <li class="nav-item dropdown">
            <a
              class="nav-link dropdown-toggle d-flex align-items-center gap-2 py-1 px-3 rounded-pill bg-light bg-opacity-10 text-white"
              href="#"
              id="userMenuDropdown"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <i class="bi bi-person-circle fs-5 text-warning"></i>
              <span class="fw-semibold"><%= currentUser.name %></span>
              <span class="badge <%= currentUser.role === 'admin' ? 'bg-danger' : 'bg-info text-dark' %> text-uppercase" style="font-size: 0.65rem;">
                <%= currentUser.role %>
              </span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3" aria-labelledby="userMenuDropdown">
              <li>
                <div class="px-3 py-2 text-muted small">
                  Signed in as<br />
                  <strong class="text-dark"><%= currentUser.email %></strong>
                </div>
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item text-danger d-flex align-items-center gap-2" href="/auth/logout">
                  <i class="bi bi-box-arrow-right"></i>Sign Out
                </a>
              </li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link text-white-50" href="/auth/login">
              <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
            </a>
          </li>
          <li class="nav-item">
            <a class="btn btn-sm btn-outline-light rounded-pill px-3" href="/auth/register">
              <i class="bi bi-person-plus me-1"></i>Sign Up
            </a>
          </li>
        <% } %>
      </ul>
    </div>

  </div>
</nav>
<!-- ── End Navbar ───────────────────────────────────────────────── -->
