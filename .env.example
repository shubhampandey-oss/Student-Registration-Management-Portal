# Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to Git.

# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Session secret ──────────────────────────────────
# Generate a strong random string for production.
# Example (PowerShell): -join ((65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
SESSION_SECRET=change_this_to_a_long_random_string_in_production

# ── Database ─────────────────────────────────────────
# SQLite file path (relative to project root)
DB_PATH=./data/portal.db

# ── External API (Task 7) ────────────────────────────
# REST Countries API — free, no key required.
# Leave blank if not using.
COUNTRIES_API_BASE=https://restcountries.com/v3.1

# Open Library search API — free, no key required.
# Used to suggest course reading materials.
OPEN_LIBRARY_BASE=https://openlibrary.org

# ── Rate limiting ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
